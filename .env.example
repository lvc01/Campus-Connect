# ======================
# DATABASE
# ======================
DATABASE_URL=postgresql+asyncpg://campus_connect:password@localhost:5432/campus_connect
POSTGRES_USER=campus_connect
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=campus_connect

# ======================
# REDIS
# ======================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ======================
# MEILISEARCH
# ======================
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=
MEILI_MASTER_KEY=change-me-master-key

# ======================
# AUTH / JWT
# ======================
JWT_ACCESS_SECRET=change-me-access-secret-key
JWT_REFRESH_SECRET=change-me-refresh-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================
# UNIVERSITY EMAIL
# ======================
ALLOWED_EMAIL_DOMAINS=cuchd.in

# ======================
# OTP
# ======================
OTP_DELIVERY_METHOD=console
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ======================
# SMTP (when OTP_DELIVERY_METHOD=smtp)
# ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@campusconnect.co.za

# ======================
# CORS
# ======================
CORS_ORIGINS=http://localhost:3000

# ======================
# STORAGE
# ======================
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL_PREFIX=

# ======================
# APP
# ======================
APP_NAME=CU Campus Connect
ENVIRONMENT=development
DEBUG=true

# ======================
# SENTRY (optional)
# ======================
SENTRY_DSN=
