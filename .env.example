# ======================
# DATABASE
# ======================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/campus_connect

# ======================
# AUTH / JWT
# ======================
JWT_ACCESS_SECRET=change-me-access-secret-key
JWT_REFRESH_SECRET=change-me-refresh-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================
# UNIVERSITY EMAIL
# ======================
ALLOWED_EMAIL_DOMAINS=cuchd.in

# ======================
# OTP
# ======================
OTP_DELIVERY_METHOD=console
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ======================
# SMTP (when OTP_DELIVERY_METHOD=smtp)
# ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@campusconnect.co.za

# ======================
# CORS
# ======================
CORS_ORIGINS=http://localhost:3000

# ======================
# APP
# ======================
APP_NAME=CU Campus Connect
DEBUG=true
