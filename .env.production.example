# ──────────────────────────── CAMPAIGN CONNECT: PRODUCTION ENV ────────────────────────────
#
# Copy this file to a *real* secret location (Render Dashboard / GitHub
# encrypted secrets). **Do not commit a populated version** — values below
# are placeholders only.

# ── DATABASE (Supabase direct, port 5432) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── REDIS (Upstash Free) ──────────────────────────────────────────────────────
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
REDIS_ENABLED=true

# ── UPSTASH SEARCH (free tier; or leave blank to fall back to ILIKE) ──────────
UPSTASH_SEARCH_URL=https://<host>.upstash.io
UPSTASH_SEARCH_TOKEN=<token>

# ── AUTH / JWT (64-hex random tokens) ─────────────────────────────────────────
JWT_ACCESS_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── EMAIL DOMAINS ─────────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAINS=cuchd.in

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_DELIVERY_METHOD=console
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── CORS (comma-separated; the *exact* deployed Vercel URL) ──────────────────
CORS_ORIGINS=https://<name>.vercel.app

# ── APP / ENV ────────────────────────────────────────────────────────────────
APP_NAME=CU Campus Connect
ENVIRONMENT=production
DEBUG=false

# ── STORAGE (Cloudflare R2) ──────────────────────────────────────────────────
STORAGE_PROVIDER=r2
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<r2-access-key>
S3_SECRET_KEY=<r2-secret-key>
S3_BUCKET_NAME=campus-connect-media
S3_PUBLIC_URL_PREFIX=https://pub-<id>.r2.dev
